<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="seq_store_driver_request_batch" model="ir.sequence">
            <field name="name">طلبات تطبيق السائقين</field>
            <field name="code">trnsp.store.driver.request.batch</field>
            <field name="prefix">DRV/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="trnsp_store_driver_request_batch_form" model="ir.ui.view">
            <field name="name">trnsp.store.driver.request.batch.form</field>
            <field name="model">trnsp.store.driver.request.batch</field>
            <field name="arch" type="xml">
                <form string="طلبات تطبيق السائقين">

                    <header>
                        <button name="action_mark_done"
                                string="إكمال السائق"
                                type="object"
                                class="oe_highlight"
                                attrs="{'invisible':[('state','!=','draft')]}"/>

                        <button name="action_start_review"
                                string="بدء المراجعة"
                                type="object"
                                class="oe_highlight"
                                groups="qimamhd_transportation_driver_delivery.group_driver_request_reviewer"
                                attrs="{'invisible':[('state','not in',['draft','done'])]}"/>

                        <button name="action_accept_all"
                                string="قبول جميع السطور"
                                type="object"
                                groups="qimamhd_transportation_driver_delivery.group_driver_request_reviewer"
                                attrs="{'invisible':[('state','!=','review')]}"/>

                        <button name="action_approve"
                                string="اعتماد"
                                type="object"
                                class="oe_highlight"
                                groups="qimamhd_transportation_driver_delivery.group_driver_request_reviewer"
                                attrs="{'invisible':[('state','!=','review')]}"/>

                        <button name="action_reopen"
                                string="إعادة فتح"
                                type="object"
                                groups="qimamhd_transportation_driver_delivery.group_driver_request_manager"
                                attrs="{'invisible':[('state','not in',['done','review','approved'])]}"/>

                        <button name="action_cancel"
                                string="إلغاء"
                                type="object"
                                groups="qimamhd_transportation_driver_delivery.group_driver_request_manager"
                                attrs="{'invisible':[('state','in',['cancel','transferred'])]}"/>

                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="draft,done,review,approved,transferred"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="driver_id"
                                       attrs="{'readonly':[('state','!=','draft')]}"
                                       options="{'no_quick_create':True,'no_create_edit':True,'no_create':True}"/>
                                <field name="branch_id" readonly="1" force_save="1"/>
                                <field name="company_id" readonly="1" force_save="1"/>
                            </group>

                            <group>
                                <field name="month_name"
                                       attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="year"
                                       attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="review_user_id" readonly="1"
                                       attrs="{'invisible':[('review_user_id','=',False)]}"/>
                                <field name="review_date" readonly="1"
                                       attrs="{'invisible':[('review_date','=',False)]}"/>
                                <field name="approve_user_id" readonly="1"
                                       attrs="{'invisible':[('approve_user_id','=',False)]}"/>
                                <field name="approve_date" readonly="1"
                                       attrs="{'invisible':[('approve_date','=',False)]}"/>
                            </group>
                        </group>

                        <group string="ملخص الطلبات" col="6">
                            <field name="line_count" readonly="1"/>
                            <field name="gps_valid_count" readonly="1"/>
                            <field name="gps_invalid_count" readonly="1"/>
                            <field name="pending_count" readonly="1"/>
                            <field name="accepted_count" readonly="1"/>
                            <field name="rejected_count" readonly="1"/>
                        </group>

                        <notebook>
                            <page string="التوصيلات">
                                <field name="request_lines">
                                    <tree editable="bottom" default_order="request_date desc, request_time desc">
                                        <field name="mobile_uuid" optional="hide" readonly="1"/>
                                        <field name="request_date"
                                               attrs="{'readonly':[('parent.state','!=','draft')]}"/>
                                        <field name="request_time"
                                               attrs="{'readonly':[('parent.state','!=','draft')]}"/>
                                        <field name="product_car_id"
                                               attrs="{'readonly':[('parent.state','!=','draft')]}"
                                               options="{'no_quick_create':True,'no_create_edit':True,'no_create':True}"/>
                                        <field name="source_path_ids" invisible="1"/>
                                        <field name="source_path_id"
                                               attrs="{'readonly':[('parent.state','!=','draft')]}"
                                               options="{'no_quick_create':True,'no_create_edit':True,'no_create':True}"/>
                                        <field name="destination_path_ids" invisible="1"/>
                                        <field name="destination_path_id"
                                               attrs="{'readonly':[('parent.state','!=','draft')]}"
                                               options="{'no_quick_create':True,'no_create_edit':True,'no_create':True}"/>
                                        <field name="driver_latitude" optional="hide"
                                               attrs="{'readonly':[('parent.state','!=','draft')]}"/>
                                        <field name="driver_longitude" optional="hide"
                                               attrs="{'readonly':[('parent.state','!=','draft')]}"/>
                                        <field name="destination_latitude" optional="hide" readonly="1"/>
                                        <field name="destination_longitude" optional="hide" readonly="1"/>
                                        <field name="allowed_radius" optional="hide" readonly="1"/>
                                        <field name="gps_distance" readonly="1"/>
                                        <field name="gps_valid" readonly="1"/>
                                        <field name="review_state"
                                               attrs="{'readonly':[('parent.state','!=','review')]}"/>
                                        <field name="reject_reason"
                                               attrs="{'readonly':[('parent.state','!=','review')]}"/>
                                        <field name="notes"
                                               attrs="{'readonly':[('parent.state','!=','draft')]}"/>
                                        <field name="admin_notes"
                                               attrs="{'readonly':[('parent.state','not in',['review','approved'])]}"/>
                                        <field name="server_received_at" optional="hide" readonly="1"/>
                                        <field name="pricing_line_id" optional="hide" readonly="1"/>
                                        <field name="settlement_id" optional="hide" readonly="1"/>
                                        <field name="settlement_line_id" optional="hide" readonly="1"/>
                                        <field name="transferred" optional="hide" readonly="1"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="ملاحظات">
                                <field name="notes" placeholder="ملاحظات الإدارة..."/>
                            </page>
                        </notebook>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>

                </form>
            </field>
        </record>

        <record id="trnsp_store_driver_request_batch_tree" model="ir.ui.view">
            <field name="name">trnsp.store.driver.request.batch.tree</field>
            <field name="model">trnsp.store.driver.request.batch</field>
            <field name="arch" type="xml">
                <tree default_order="year desc, month_name desc, id desc"
                      decoration-info="state == 'review'"
                      decoration-success="state == 'approved'"
                      decoration-danger="state == 'cancel'">
                    <field name="name"/>
                    <field name="driver_id"/>
                    <field name="month_name"/>
                    <field name="year"/>
                    <field name="line_count" string="عدد التوصيلات"/>
                    <field name="pending_count"/>
                    <field name="accepted_count"/>
                    <field name="rejected_count"/>
                    <field name="gps_invalid_count"/>
                    <field name="state"/>
                    <field name="branch_id" optional="hide"/>
                    <field name="company_id" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="trnsp_store_driver_request_batch_search" model="ir.ui.view">
            <field name="name">trnsp.store.driver.request.batch.search</field>
            <field name="model">trnsp.store.driver.request.batch</field>
            <field name="arch" type="xml">
                <search string="البحث في طلبات التطبيق">
                    <field name="name"/>
                    <field name="driver_id"/>
                    <field name="month_name"/>
                    <field name="year"/>
                    <field name="state"/>

                    <filter string="مفتوحة" name="filter_draft"
                            domain="[('state','=','draft')]"/>
                    <filter string="مكتملة من السائق" name="filter_done"
                            domain="[('state','=','done')]"/>
                    <filter string="قيد المراجعة" name="filter_review"
                            domain="[('state','=','review')]"/>
                    <filter string="معتمدة" name="filter_approved"
                            domain="[('state','=','approved')]"/>
                    <filter string="تم التحويل" name="filter_transferred"
                            domain="[('state','=','transferred')]"/>

                    <separator/>

                    <group expand="0" string="تجميع حسب">
                        <filter string="السائق" name="group_by_driver" context="{'group_by':'driver_id'}"/>
                        <filter string="الشهر" name="group_by_month" context="{'group_by':'month_name'}"/>
                        <filter string="السنة" name="group_by_year" context="{'group_by':'year'}"/>
                        <filter string="الحالة" name="group_by_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_trnsp_store_driver_request_batch" model="ir.actions.act_window">
            <field name="name">طلبات تطبيق السائقين</field>
            <field name="res_model">trnsp.store.driver.request.batch</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="trnsp_store_driver_request_batch_search"/>
            <field name="context">{}</field>
        </record>

        <menuitem id="menu_trnsp_store_driver_request_batch"
                  name="طلبات تطبيق السائقين"
                  parent="qimamhd_transportation_v2_13.transportation_entry_menu"
                  action="action_trnsp_store_driver_request_batch"
                  sequence="75"
                  groups="qimamhd_transportation_driver_delivery.group_driver_request_reviewer"/>

    </data>
</odoo>
