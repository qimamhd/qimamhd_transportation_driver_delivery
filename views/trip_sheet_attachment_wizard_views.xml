<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="trnsp_driver_delivery_trip_sheet_attachment_wizard_form" model="ir.ui.view">
        <field name="name">trnsp.driver.delivery.trip.sheet.attachment.wizard.form</field>
        <field name="model">trnsp.driver.delivery.trip.sheet.attachment.wizard</field>
        <field name="arch" type="xml">
            <form string="إضافة مرفق">
                <group>
                    <field name="line_id" invisible="1"/>
                    <field name="attachment" filename="attachment_name"/>
                    <field name="attachment_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="إضافة المرفق" type="object" class="btn-primary"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
