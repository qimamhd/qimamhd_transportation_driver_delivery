<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="transp_store_pricing_gps_inherit" model="ir.ui.view">
            <field name="name">trnsp.store.pricing.gps.inherit</field>
            <field name="model">trnsp.store.pricing</field>
            <field name="inherit_id"
                   ref="qimamhd_transportation_v2_13.transp_store_pricing_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='pricing_lines']" position="before">
                    <group string="إعداد نطاق GPS للوجهات" col="4">
                        <field name="driver_app_default_gps_radius"/>
                        <button name="action_apply_driver_app_gps_radius"
                                type="object"
                                string="تحديث نطاق سجلات الوجهات"
                                class="oe_highlight"
                                confirm="سيتم تحديث مجال GPS لكل وجهات هذا المصدر بالقيمة المحددة. هل تريد المتابعة؟"/>
                    </group>
                </xpath>

                <xpath expr="//field[@name='pricing_lines']/tree/field[@name='gbs_to']"
                       position="after">
                    <field name="gps_radius"
                           string="مجال GPS (متر)"/>
                    <button name="action_open_destination_google_maps"
                            type="object"
                            string="فتح الموقع"
                            icon="fa-map-marker"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
